  fileName(3) = 'diags/BGC_day_PAR/BGC_day_PAR',
  frequency(3) = 86400.,
#
  fields(1:7,4) = 'TRAC01  ','TRAC02  ','TRAC03  ','TRAC04  ','TRAC05  ','TRAC06  ','TRAC07  ',
  fileName(4) = 'diags/BGC_day_consts/BGC_day_consts',
  frequency(4) = 86400.,
